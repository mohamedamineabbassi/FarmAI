% =====================================================
% COMMANDES DE MISE EN FORME
% =====================================================

% Texte souligné avec couleur
\newcommand{\highlight}[1]{%
  \colorbox{yellow!30}{\textbf{#1}}%
}

% Terme technique en petit caps + italique
\newcommand{\tech}[1]{%
  \textsc{\textit{#1}}%
}

% Important en gras + couleur
\newcommand{\important}[1]{%
  {\color{red}\textbf{#1}}%
}

% Terme avec indexation
\newcommand{\indexterm}[1]{%
  #1\index{#1}%
}

% =====================================================
% COMMANDES POUR LES FIGURES
% =====================================================

% Figure centrée avec légende personnalisée
\newcommand{\myfigure}[4]{%
  \begin{figure}[H]
    \centering
    \includegraphics[width=#2]{#1}
    \caption{#3}%
    \label{fig:#4}%
  \end{figure}%
}

% Figure côte à côte
\newcommand{\doublefigure}[6]{%
  \begin{figure}[H]
    \centering
    \begin{minipage}{0.45\textwidth}
      \centering
      \includegraphics[width=\textwidth]{#1}
      \caption{#2}%
      \label{fig:#3}%
    \end{minipage}
    \hfill
    \begin{minipage}{0.45\textwidth}
      \centering
      \includegraphics[width=\textwidth]{#4}
      \caption{#5}%
      \label{fig:#6}%
    \end{minipage}
  \end{figure}%
}

% =====================================================
% COMMANDES POUR LES TABLEAUX
% =====================================================

% En-tête de tableau personnalisé
\newcommand{\tabheader}[1]{%
  \cellcolor[gray]{0.8}%
  \textbf{\color{black}#1}%
}

% Ligne de total dans tableau
\newcommand{\tabtotal}[1]{%
  \hline%
  \cellcolor[gray]{0.9}%
  \textbf{#1}%
}

% =====================================================
% COMMANDES POUR LES ALGORITHMES
% =====================================================

% Bloc d'étapes
\newcommand{\step}[2]{%
  \noindent%
  \begin{tabularx}{\linewidth}{l>{\raggedright\arraybackslash}X}%
    \textbf{Étape #1} & #2\\%
  \end{tabularx}%
  \vspace{0.3cm}%
}

% =====================================================
% ENVIRONNEMENTS PERSONNALISÉS
% =====================================================

% Environnement pour les points clés
\newenvironment{keypoints}{%
  \begin{itemize}[label=$\star$, leftmargin=1cm]%
}{%
  \end{itemize}%
}

% Environnement pour les objectifs
\newenvironment{objectives}{%
  \subsection*{Objectifs}%
  \begin{itemize}[label=$\checkmark$, leftmargin=1cm]%
}{%
  \end{itemize}%
}

% Environnement pour les résultats attendus
\newenvironment{expected}{%
  \subsection*{Résultats attendus}%
  \begin{itemize}[label=$\rightarrow$, leftmargin=1cm]%
}{%
  \end{itemize}%
}

% =====================================================
% COMMANDES ACADÉMIQUES
% =====================================================

% Citation avec auteur
\newcommand{\citation}[2]{%
  \begin{quotation}%
    \textit{« #1 »}%
    \linebreak%
    \hspace*{\fill}--- \textbf{#2}%
  \end{quotation}%
}

% Terme en début de chapitre
\newcommand{\chapintro}[1]{%
  \begin{itshape}%
  \noindent\textbf{Résumé :}\\%
  #1%
  \end{itshape}%
  \vspace{1cm}%
}

% =====================================================
% MACROS POUR LE PROJET FARM AI
% =====================================================

% Nom du projet
\newcommand{\farmai}{\textbf{\textit{Farm AI}}}

% Mention de technologie
\newcommand{\tech@}[1]{%
  \colorbox{blue!20}{\texttt{#1}}%
}

% Lien vers une partie du projet
\newcommand{\projectref}[2]{%
  cf. \ref{#1} : \textit{``#2''}%
}

% =====================================================
% COMMANDES POUR LES FORMULES
% =====================================================

% Encadrement de formule importante
\newcommand{\importantformula}[1]{%
  \[%
  \boxed{#1}%
  \]%
}

% Formule numérotée avec explication
\newcommand{\formulawith}[2]{%
  \begin{equation}%
  #1%
  \end{equation}%
  \textit{où :} #2%
}

% =====================================================
% UTILITAIRES
% =====================================================

% Séparateur horizontal
\newcommand{\separator}{%
  \vspace{0.5cm}%
  \noindent%
  \rule{\textwidth}{0.5pt}%
  \vspace{0.5cm}%
}

% Espace blanc controlé
\newcommand{\bigvspace}{\vspace{1.5cm}}
\newcommand{\medvspace}{\vspace{1cm}}
\newcommand{\smallvspace}{\vspace{0.5cm}}

% Double ligne vide
\newcommand{\doublebreak}{%
  \linebreak%
  \linebreak%
}

% =====================================================
% FOOTER PERSONNALISÉ
% =====================================================

% Marquer un document comme brouillon
\newcommand{\draft}{%
  \usepackage{draftwatermark}%
  \SetWatermarkText{BROUILLON}%
  \SetWatermarkScale{3}%
  \SetWatermarkOpacity{0.1}%
}

